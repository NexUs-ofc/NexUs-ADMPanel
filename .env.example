# Copie para .env.local e preencha. Barra no fim é opcional.

# Endereço de cada serviço. Serviço sem endereço aparece no menu como "não configurado".
VITE_AUTH_API_URL=http://localhost:8080
VITE_CORE_API_URL=http://localhost:8081
VITE_NOTIFY_API_URL=http://localhost:8082
VITE_IA_API_URL=http://localhost:8000
VITE_BI_IA_API_URL=http://localhost:8001

# SHA-256 da chave do painel (a ADMIN_API_KEY dos serviços). Preenchido, o próprio painel confere a
# chave no login, mesmo com os serviços fora do ar. Nunca coloque a chave em texto puro aqui: tudo
# que começa com VITE_ vai para o JavaScript que o navegador baixa. Para gerar:
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "<chave>"
VITE_ADMIN_KEY_SHA256=

# true = dados de demonstração gerados no navegador, sem chamar nenhum serviço.
# Qualquer chave entra. Útil para desenvolver as telas sem backend.
VITE_DEMO_MODE=false
